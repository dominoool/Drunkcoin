<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>DRUNK COIN — The Live Streaming Coin</title>
<meta name="description" content="Drunk Coin ($DRUNK) — the live streaming coin. Market cap $0 until official launch." />
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Orbitron:wght@500;800;900&family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #07040a;
    --gold: #e4b84a;
    --gold2: #f6e2a2;
    --muted: #b7a48a;
    --red: #ff3b4e;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: #f7efe0; font-family: Outfit, sans-serif; overflow-x: hidden; }
  body::before {
    content: "";
    position: fixed; inset: 0; pointer-events: none;
    background:
      radial-gradient(ellipse at 50% -10%, rgba(228,184,74,.16), transparent 50%),
      radial-gradient(circle at 85% 15%, rgba(255,59,78,.08), transparent 32%);
  }
  header {
    position: relative; z-index: 2;
    display: flex; justify-content: space-between; align-items: center;
    padding: 1.15rem 6vw;
    border-bottom: 1px solid rgba(228,184,74,.2);
    background: rgba(7,4,10,.72); backdrop-filter: blur(16px);
  }
  .brand { font-family: Cinzel, serif; font-weight: 900; letter-spacing: .22em; color: var(--gold); }
  .pill {
    font-size: .68rem; letter-spacing: .14em; text-transform: uppercase;
    padding: .35rem .7rem; border-radius: 99px;
    border: 1px solid rgba(255,59,78,.45); color: #ffd0d4;
  }
  .pill i {
    display: inline-block; width: 7px; height: 7px; border-radius: 50%;
    background: var(--red); margin-right: .4rem; box-shadow: 0 0 10px var(--red);
    animation: pulse 1.2s infinite;
  }
  @keyframes pulse { 50% { opacity: .3; } }
  .hero { position: relative; z-index: 2; text-align: center; padding: 5.5rem 6vw 2.5rem; }
  .eyebrow { font-family: Orbitron, sans-serif; font-size: .72rem; letter-spacing: .38em; color: var(--gold); }
  h1 {
    font-family: Cinzel, serif; font-weight: 900;
    font-size: clamp(2.8rem, 9vw, 7rem); line-height: .9; margin: .7rem 0 1rem;
    background: linear-gradient(180deg, #fff4c8, var(--gold) 50%, #8a5a12);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .sub { max-width: 560px; margin: 0 auto 2.4rem; color: var(--muted); }
  .stage {
    max-width: 820px; margin: 0 auto; padding: 1.8rem 1.6rem 1.5rem;
    border: 1px solid rgba(228,184,74,.32);
    background: linear-gradient(180deg, rgba(228,184,74,.08), rgba(255,255,255,.02));
    box-shadow: 0 30px 80px rgba(0,0,0,.45);
  }
  .cap-label { font-family: Orbitron, sans-serif; font-size: .68rem; letter-spacing: .28em; color: var(--gold); }
  #mcap {
    font-family: Orbitron, sans-serif; font-weight: 900;
    font-size: clamp(2.8rem, 9vw, 5.6rem);
    color: #fff3c4; text-shadow: 0 0 40px rgba(228,184,74,.35);
  }
  .meta { display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap; margin-top: .8rem; color: var(--muted); font-size: .9rem; }
  .meta b { color: var(--gold2); font-family: Orbitron, sans-serif; }
  .note { margin-top: .7rem; font-size: .82rem; color: #8a7a66; }
  .actions { display: flex; justify-content: center; gap: .8rem; flex-wrap: wrap; margin: 1.6rem 0 0; }
  .btn { text-decoration: none; font-weight: 600; padding: .85rem 1.4rem; border-radius: 999px; display: inline-block; }
  .btn.gold { background: var(--gold); color: #1a1004; }
  .btn.ghost { border: 1px solid rgba(228,184,74,.4); color: var(--gold2); }
  .stream-wrap { position: relative; z-index: 2; max-width: 1100px; margin: 3rem auto 0; padding: 0 6vw 3rem; }
  .stream-label { font-family: Orbitron, sans-serif; font-size: .7rem; letter-spacing: .24em; color: var(--gold); margin-bottom: .7rem; }
  .placeholder {
    height: 320px; border: 1px solid rgba(228,184,74,.28);
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 1.5rem;
    background: radial-gradient(circle at 50% 40%, rgba(255,59,78,.16), transparent 45%), #0b0710;
  }
  .placeholder h3 { font-family: Cinzel, serif; font-size: 2rem; color: var(--gold2); }
  .placeholder p { color: var(--muted); margin-top: .5rem; }
  .grid {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem; max-width: 1100px; margin: 0 auto; padding: 0 6vw 4rem;
  }
  .card { padding: 1.2rem; border: 1px solid rgba(228,184,74,.16); background: rgba(16,10,18,.7); }
  .card h4 { font-family: Cinzel, serif; color: var(--gold); margin-bottom: .4rem; }
  .card p { color: var(--muted); font-size: .92rem; }
  footer { position: relative; z-index: 2; text-align: center; padding: 2rem 6vw 3rem; color: #6d5d4d; font-size: .78rem; border-top: 1px solid rgba(228,184,74,.12); }
</style>
</head>
<body>
  <header>
    <div class="brand">DRUNK COIN</div>
